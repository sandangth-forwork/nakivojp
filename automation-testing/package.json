{
  "name": "NakivoJp api tests",
  "version": "1.0.0",
  "description": "Playwright + TypeScript API test suite for the Jobs API",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
